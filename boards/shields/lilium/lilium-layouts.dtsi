#include <physical_layouts.dtsi>

/ {
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";

        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys = <
            /* Row 0 */
            &key_physical_attrs 75 75 100  40 0 0 0
            &key_physical_attrs 75 75 200  40 0 0 0
            &key_physical_attrs 75 75 300  20 0 0 0
            &key_physical_attrs 75 75 400   0 0 0 0
            &key_physical_attrs 75 75 500  20 0 0 0
            &key_physical_attrs 75 75 600  40 0 0 0
            &key_physical_attrs 75 75 1000 40 0 0 0
            &key_physical_attrs 75 75 1100 20 0 0 0
            &key_physical_attrs 75 75 1200 0 0 0 0
            &key_physical_attrs 75 75 1300 20 0 0 0
            &key_physical_attrs 75 75 1400 40 0 0 0
            &key_physical_attrs 75 75 1500 40 0 0 0

            /* Row 1 */
            &key_physical_attrs 75 75 100 140 0 0 0
            &key_physical_attrs 75 75 200 140 0 0 0
            &key_physical_attrs 75 75 300 120 0 0 0
            &key_physical_attrs 75 75 400 100 0 0 0
            &key_physical_attrs 75 75 500 120 0 0 0
            &key_physical_attrs 75 75 600 140 0 0 0
            &key_physical_attrs 75 75 1000 140 0 0 0
            &key_physical_attrs 75 75 1100 120 0 0 0
            &key_physical_attrs 75 75 1200 100 0 0 0
            &key_physical_attrs 75 75 1300 120 0 0 0
            &key_physical_attrs 75 75 1400 140 0 0 0
            &key_physical_attrs 75 75 1500 140 0 0 0

            /* Row 2 */
            &key_physical_attrs 75 75 100 240 0 0 0
            &key_physical_attrs 75 75 200 240 0 0 0
            &key_physical_attrs 75 75 300 220 0 0 0
            &key_physical_attrs 75 75 400 200 0 0 0
            &key_physical_attrs 75 75 500 220 0 0 0
            &key_physical_attrs 75 75 600 240 0 0 0
            &key_physical_attrs 75 75 1000 240 0 0 0
            &key_physical_attrs 75 75 1100 220 0 0 0
            &key_physical_attrs 75 75 1200 200 0 0 0
            &key_physical_attrs 75 75 1300 220 0 0 0
            &key_physical_attrs 75 75 1400 240 0 0 0
            &key_physical_attrs 75 75 1500 240 0 0 0

            /* Row 3 */
            &key_physical_attrs 75 75 100 340 0 0 0
            &key_physical_attrs 75 75 200 340 0 0 0
            &key_physical_attrs 75 75 300 320 0 0 0
            &key_physical_attrs 75 75 400 300 0 0 0
            &key_physical_attrs 75 75 500 320 0 0 0
            &key_physical_attrs 75 75 600 340 0 0 0
            &key_physical_attrs 75 75 1000 340 0 0 0
            &key_physical_attrs 75 75 1100 320 0 0 0
            &key_physical_attrs 75 75 1200 300 0 0 0
            &key_physical_attrs 75 75 1300 320 0 0 0
            &key_physical_attrs 75 75 1400 340 0 0 0
            &key_physical_attrs 75 75 1500 340 0 0 0

            /* Row 4 */
            &key_physical_attrs 75 75 100 440 0 0 0
            &key_physical_attrs 75 75 200 440 0 0 0
            &key_physical_attrs 75 75 300 420 0 0 0
            &key_physical_attrs 75 75 400 400 0 0 0
            &key_physical_attrs 75 75 500 420 0 0 0
            &key_physical_attrs 75 75 600 440 0 0 0
            &key_physical_attrs 75 75 1000 440 0 0 0
            &key_physical_attrs 75 75 1100 420 0 0 0
            &key_physical_attrs 75 75 1200 400 0 0 0
            &key_physical_attrs 75 75 1300 420 0 0 0
            &key_physical_attrs 75 75 1400 440 0 0 0
            &key_physical_attrs 75 75 1500 440 0 0 0
        >;
    }
}