#include <physical_layouts.dtsi>

/ {
    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";

        transform = <&default_transform>;
        kscan = <&kscan0>;

    keys:
      # Row 0
      - {x:  1.0, y: 0.4}
      - {x:  2.0, y: 0.4}
      - {x:  3.0, y: 0.2}
      - {x:  4.0, y: 0.0}
      - {x:  5.0, y: 0.2}
      - {x:  6.0, y: 0.4}
      - {x: 10.0, y: 0.4}
      - {x: 11.0, y: 0.2}
      - {x: 12.0, y: 0.0}
      - {x: 13.0, y: 0.2}
      - {x: 14.0, y: 0.4}
      - {x: 15.0, y: 0.4}

      # Row 1
      - {x:  1.0, y: 1.4}
      - {x:  2.0, y: 1.4}
      - {x:  3.0, y: 1.2}
      - {x:  4.0, y: 1.0}
      - {x:  5.0, y: 1.2}
      - {x:  6.0, y: 1.4}
      - {x: 10.0, y: 1.4}
      - {x: 11.0, y: 1.2}
      - {x: 12.0, y: 1.0}
      - {x: 13.0, y: 1.2}
      - {x: 14.0, y: 1.4}
      - {x: 15.0, y: 1.4}

      # Row 2
      - {x:  1.0, y: 2.4}
      - {x:  2.0, y: 2.4}
      - {x:  3.0, y: 2.2}
      - {x:  4.0, y: 2.0}
      - {x:  5.0, y: 2.2}
      - {x:  6.0, y: 2.4}
      - {x: 10.0, y: 2.4}
      - {x: 11.0, y: 2.2}
      - {x: 12.0, y: 2.0}
      - {x: 13.0, y: 2.2}
      - {x: 14.0, y: 2.4}
      - {x: 15.0, y: 2.4}

      # Row 3
      - {x:  1.0, y: 3.4}
      - {x:  2.0, y: 3.4}
      - {x:  3.0, y: 3.2}
      - {x:  4.0, y: 3.0}
      - {x:  5.0, y: 3.2}
      - {x:  6.0, y: 3.4}
      - {x: 10.0, y: 3.4}
      - {x: 11.0, y: 3.2}
      - {x: 12.0, y: 3.0}
      - {x: 13.0, y: 3.2}
      - {x: 14.0, y: 3.4}
      - {x: 15.0, y: 3.4}

      # Row 4
      - {x:  1.0, y: 4.4}
      - {x:  2.0, y: 4.4}
      - {x:  3.0, y: 4.2}
      - {x:  4.0, y: 4.0}
      - {x:  5.0, y: 4.2}
      - {x:  6.0, y: 4.4}
      - {x: 10.0, y: 4.4}
      - {x: 11.0, y: 4.2}
      - {x: 12.0, y: 4.0}
      - {x: 13.0, y: 4.2}
      - {x: 14.0, y: 4.4}
      - {x: 15.0, y: 4.4}

