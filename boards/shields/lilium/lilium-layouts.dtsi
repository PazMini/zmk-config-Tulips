#include <physical_layouts.dtsi>

/ {
    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";

        transform = <&default_transform>;
        kscan = <&kscan0>;

    keys:
      # Left half
      - {x: 0,    y:   0, r: 0}
      - {x: 19.8, y:   0, r: 0}
      - {x: 39.6, y:   7, r: 0}
      - {x: 59.4, y:   5, r: 0}
      - {x: 79.2, y:  -6, r: 0}
      - {x: 99.0, y:  -3, r: 0}

      - {x: 0,    y: 19.8, r: 0}
      - {x: 19.8, y: 19.8, r: 0}
      - {x: 39.6, y: 26.8, r: 0}
      - {x: 59.4, y: 24.8, r: 0}
      - {x: 79.2, y: 13.8, r: 0}
      - {x: 99.0, y: 16.8, r: 0}

      - {x: 0,    y: 39.6, r: 0}
      - {x: 19.8, y: 39.6, r: 0}
      - {x: 39.6, y: 46.6, r: 0}
      - {x: 59.4, y: 44.6, r: 0}
      - {x: 79.2, y: 33.6, r: 0}
      - {x: 99.0, y: 36.6, r: 0}

      - {x: 0,    y: 59.4, r: 0}
      - {x: 19.8, y: 59.4, r: 0}
      - {x: 39.6, y: 66.4, r: 0}
      - {x: 59.4, y: 64.4, r: 0}
      - {x: 79.2, y: 53.4, r: 0}
      - {x: 99.0, y: 56.4, r: 0}

      - {x: 0,    y: 79.2, r: 0}
      - {x: 19.8, y: 79.2, r: 0}
      - {x: 39.6, y: 86.2, r: 0}
      - {x: 59.4, y: 84.2, r: 0}
      - {x: 79.2, y: 73.2, r: 0}
      - {x: 99.0, y: 76.2, r: 0}

      # Right half (mirrored)
      - {x: 159.0, y:   0, r: 0}
      - {x: 178.8, y:   0, r: 0}
      - {x: 198.6, y:   7, r: 0}
      - {x: 218.4, y:   5, r: 0}
      - {x: 238.2, y:  -6, r: 0}
      - {x: 258.0, y:  -3, r: 0}

      - {x: 159.0, y: 19.8, r: 0}
      - {x: 178.8, y: 19.8, r: 0}
      - {x: 198.6, y: 26.8, r: 0}
      - {x: 218.4, y: 24.8, r: 0}
      - {x: 238.2, y: 13.8, r: 0}
      - {x: 258.0, y: 16.8, r: 0}

      - {x: 159.0, y: 39.6, r: 0}
      - {x: 178.8, y: 39.6, r: 0}
      - {x: 198.6, y: 46.6, r: 0}
      - {x: 218.4, y: 44.6, r: 0}
      - {x: 238.2, y: 33.6, r: 0}
      - {x: 258.0, y: 36.6, r: 0}

      - {x: 159.0, y: 59.4, r: 0}
      - {x: 178.8, y: 59.4, r: 0}
      - {x: 198.6, y: 66.4, r: 0}
      - {x: 218.4, y: 64.4, r: 0}
      - {x: 238.2, y: 53.4, r: 0}
      - {x: 258.0, y: 56.4, r: 0}

      - {x: 159.0, y: 79.2, r: 0}
      - {x: 178.8, y: 79.2, r: 0}
      - {x: 198.6, y: 86.2, r: 0}
      - {x: 218.4, y: 84.2, r: 0}
      - {x: 238.2, y: 73.2, r: 0}
      - {x: 258.0, y: 76.2, r: 0}
    }
}